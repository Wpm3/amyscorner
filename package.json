{
  "name": "clearread",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "domutils": "^4.0.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/build-pdf-extractor.js",
    "build:pdf-extractor": "node scripts/build-pdf-extractor.js",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "desktop:prepare": "expo export --platform web && node scripts/prepare-desktop.js",
    "desktop:start": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:build:win": "npm run desktop:prepare && npm --prefix desktop run build:win",
    "desktop:build:win:lite": "expo export --platform web && npm --prefix desktop-lite run build",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/fixtures/",
      "/desktop/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(htmlparser2|domhandler|domelementtype|domutils|dom-serializer|entities|fast-xml-parser|strnum|fflate)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/desktop/",
      "<rootDir>/dist/"
    ]
  }
}
